[Unit]
Description=BPGA Modbus acquisition and web monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=admin
Group=dialout
WorkingDirectory=/home/admin/bpga
ExecStart=/usr/bin/python3 /home/admin/bpga/bpga_server.py
Restart=always
RestartSec=2
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
